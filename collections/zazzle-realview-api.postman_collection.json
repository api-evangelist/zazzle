      "id": "27e0eb81-a2de-4819-9eff-dd7e9b39b557",
      "name": "RealView",
      "description": {
        "content": "Dynamic product mockup image rendering.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5a0645f3-7fc8-4798-bc46-9f6d414bbdb7",
          "name": "Render a RealView product image for a template",
          "request": {
            "name": "Render a RealView product image for a template",
            "description": {
              "content": "Returns a square product image of the given template with the supplied image and text\nsubstituted into its template objects. Template object parameters are named after the URL\nParameter Name assigned to each object in the Zazzle design tool, defaulting to `image1`,\n`text1`, … and incrementing per object.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "svc",
                "view"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pid",
                  "value": "<string>",
                  "description": "(Required) Template Product ID, the 18-digit number at the end of the template product URL.\n"
                },
                {
                  "disabled": false,
                  "key": "max_dim",
                  "value": "<integer>",
                  "description": "(Required) Size in pixels of the returned (square) image. Values above 699 return an image with a\nZazzle-branded frame.\n"
                },
                {
                  "disabled": false,
                  "key": "at",
                  "value": "<string>",
                  "description": "(Required) Your Zazzle member account ID."
                },
                {
                  "disabled": false,
                  "key": "t_image1_url",
                  "value": "<string>",
                  "description": "URL-encoded link to the image placed into the first template image object. Required when\nthe template declares an image object. Note this is `_url`, not the Create-a-Product\n`_iid` suffix. Rename-aware: `t_<objectName>_url`.\n"
                },
                {
                  "disabled": false,
                  "key": "t_image2_url",
                  "value": "<string>",
                  "description": "URL-encoded link to the image placed into the second template image object."
                },
                {
                  "disabled": false,
                  "key": "t_text1_txt",
                  "value": "<string>",
                  "description": "Encoded text placed into the first template text object. Required when the template\ndeclares a text object.\n"
                },
                {
                  "disabled": false,
                  "key": "t_text2_txt",
                  "value": "<string>",
                  "description": "Encoded text placed into the second template text object."
                },
                {
                  "disabled": false,
                  "key": "t_text1_txtclr",
                  "value": "<string>",
                  "description": "Text color for the first template text object, as a 6-digit hex color code."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
